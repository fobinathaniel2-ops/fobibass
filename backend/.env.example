# ======================================
# SERVER
# ======================================
PORT=5000
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=https://your-site.netlify.app,http://localhost:5500
# Public URL of THIS backend (used to build links in emails, e.g. attendance confirm links)
APP_URL=https://your-backend.onrender.com
# Public URL of the hosted frontend (used to build login links in emails)
FRONTEND_URL=https://your-site.netlify.app

# ======================================
# YOUTUBE DATA API
# Enable YouTube Data API v3 in Google Cloud Console.
# ======================================
YOUTUBE_API_KEY=your-youtube-data-api-key
YOUTUBE_CHANNEL_HANDLE=FOBIbass

# ======================================
# CLOUDINARY
# ======================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=fobee-bass

# ======================================
# EMAIL (Nodemailer / SMTP)
# For Gmail: use an "App Password" (not your normal password) — https://myaccount.google.com/apppasswords
# ======================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="FOBIbass <your-sending-address@gmail.com>"

# ======================================
# ADMIN
# Comma-separated list of admin emails allowed to hit /api/admin/* routes
# ======================================
ADMIN_EMAILS=fobibismarkamoako@gmail.com

# ======================================
# SECURITY
# ======================================
# Long random string — e.g. `openssl rand -hex 32`
JWT_SECRET=replace-this-with-a-long-random-string
SESSION_SECRET=replace-this-with-a-long-random-session-secret

# ======================================
# OTP
# ======================================
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
